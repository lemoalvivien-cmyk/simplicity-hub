# ─────────────────────────────────────────────────────────────────────────────
# WIINUP MAX — Environment variables template
# Copy this file to .env for local development.
# NEVER commit .env with real values.
# The repo MUST be private. Rotate all keys if ever exposed publicly.
# ─────────────────────────────────────────────────────────────────────────────

# Auto-injected by Lovable Cloud — do not set manually in production
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ── Edge Function Secrets (set via Lovable Cloud > Secrets, NEVER in .env) ──
# STRIPE_SECRET_KEY=sk_live_...          # Stripe live secret key
# STRIPE_WEBHOOK_SECRET=whsec_...        # REQUIRED for webhook sig verification
# RESEND_API_KEY=re_...                  # Email provider (reactivation, transactional)
# ELEVENLABS_API_KEY=...                 # Voice AI (optional)
# CRON_SECRET=...                        # REQUIRED — shared secret for pg_cron → process-pending-payouts
#                                        # Generate with: openssl rand -hex 32
# BANK_WEBHOOK_SECRET=...               # REQUIRED — signature for bank webhook
#                                        # Generate with: openssl rand -hex 32
# INTERNAL_FUNCTION_SECRET=...          # REQUIRED — shared secret for pg_net → notify-* functions
#                                        # Generate with: openssl rand -hex 32
#                                        # Add to EVERY pg_net.http_post call as header: x-internal-secret
