# Copie ce fichier en .env.local et remplis les valeurs
# NE JAMAIS commiter .env avec de vraies valeurs

# Supabase (clés publiques — disponibles dans le Dashboard Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Ces variables sont injectées automatiquement par Lovable Cloud
# Ne pas les définir manuellement en production
