{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    // Progressive strictness hardening — Phase 1 of 3
    // Phase 1 (current): Enable key guards without breaking existing base
    //   strictNullChecks: false — ~200 errors in existing code, deferred to Phase 2
    //   strict: false — too many errors in auto-generated UI code, deferred to Phase 3
    //   noImplicitAny: false — deferred; ~50 gradual errors expected
    // Phase 2 target: strictNullChecks: true + fix null-deref in critical paths
    // Phase 3 target: strict: true + noImplicitAny: true
    // HONEST LIMIT: strict:true requires fixing ~150+ type errors in existing code.
    // This is a known risk documented in docs/PRODUCTION_READYNESS.md.
    "strict": false,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "useUnknownInCatchVariables": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}